# Rich log format for analytics: adds request time, referer, host on top of
# the standard combined fields. GoAccess parses this via the matching
# log-format string in its config (see analytics/goaccess.conf).
log_format agentty_detailed '$remote_addr - $remote_user [$time_local] '
                            '"$request" $status $body_bytes_sent '
                            '"$http_referer" "$http_user_agent" '
                            'rt=$request_time host=$host';

server {
    listen 80;
    listen [::]:80;
    server_name agentty.org www.agentty.org;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name agentty.org www.agentty.org;

    ssl_certificate /etc/letsencrypt/live/agentty.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agentty.org/privkey.pem;

    ssl_session_timeout 1d;
    ssl_session_cache shared:AgenttyOrgSSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    if ($host = www.agentty.org) {
        return 301 https://agentty.org$request_uri;
    }

    root /var/www/agentty.org;
    index index.html;

    # Dedicated detailed log for this site only (consumed by GoAccess).
    access_log /var/log/nginx/agentty.access.log agentty_detailed;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;

    # Cross-origin isolation (Lighthouse "COOP" / origin-isolation audits).
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header X-Permitted-Cross-Domain-Policies "none" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()" always;

    # Content-Security-Policy. The site is a static Next.js export; the only
    # inline scripts are the pre-paint theme setter and the JSON-LD block, so
    # we allow 'unsafe-inline' for scripts. Umami is loaded from our own
    # analytics subdomain. Trusted Types is advertised in report-only mode so
    # the main policy never breaks Next.js client-side navigation.
    set $csp "default-src 'self'; ";
    set $csp "${csp}base-uri 'self'; ";
    set $csp "${csp}object-src 'none'; ";
    set $csp "${csp}frame-ancestors 'self'; ";
    set $csp "${csp}form-action 'self'; ";
    set $csp "${csp}img-src 'self' data:; ";
    set $csp "${csp}font-src 'self' data:; ";
    set $csp "${csp}style-src 'self' 'unsafe-inline'; ";
    set $csp "${csp}script-src 'self' 'unsafe-inline' https://analytics.agentty.org; ";
    set $csp "${csp}connect-src 'self' https://analytics.agentty.org; ";
    set $csp "${csp}upgrade-insecure-requests;";
    add_header Content-Security-Policy $csp always;
    # Trusted Types in report-only — satisfies the DOM-XSS audit without risking
    # a hard break of the SPA router. Promote to enforcing once verified clean.
    add_header Content-Security-Policy-Report-Only "require-trusted-types-for 'script'; trusted-types 'allow-duplicates'" always;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_types
        text/plain text/css text/javascript
        application/javascript application/x-javascript application/json
        application/xml application/manifest+json application/wasm
        image/svg+xml font/woff2;
    # Serve pre-compressed .gz / .br siblings when the build produced them
    # (zero CPU at request time, smaller than on-the-fly gzip level 6).
    gzip_static on;

    # HTML is the deploy-fresh entry point: every request must revalidate so a
    # new deploy is picked up instantly. The fingerprinted /_next/static assets
    # it references stay immutable + 1y-cached below, so this costs almost
    # nothing. Applied to `location /` because static-export routes are
    # extensionless (`/`, `/docs`, `/compare/...`) — try_files resolves them to
    # .html internally, but the *request* URI has no extension, so a
    # `~ \.html$` location would never match them.
    location / {
        try_files $uri $uri/ $uri.html $uri/index.html =404;
        add_header Cache-Control "no-cache" always;
        # Re-assert the security headers: defining add_header inside a location
        # replaces (does not inherit) the server-level set in nginx.
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
        add_header X-Permitted-Cross-Domain-Policies "none" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), browsing-topics=()" always;
        add_header Content-Security-Policy $csp always;
        add_header Content-Security-Policy-Report-Only "require-trusted-types-for 'script'; trusted-types 'allow-duplicates'" always;
    }

    # The one-line installer advertised on the site & social cards.
    # Serve the raw shell script with a sane content-type and no caching
    # so `curl -fsSL https://agentty.org/install.sh | sh` always gets latest.
    location = /install.sh {
        default_type text/x-shellscript;
        add_header Cache-Control "no-cache" always;
    }
    location = /install.ps1 {
        default_type text/plain;
        add_header Cache-Control "no-cache" always;
    }

    # Next.js generates the social-share cards as extensionless routes;
    # force the PNG content-type so crawlers (Google, Slack, X, LinkedIn, …)
    # accept them. This must cover NESTED routes too
    # (/blog/<post>/opengraph-image, /compare/<slug>/twitter-image, …), not
    # just the root card — an exact `location =` only matched the homepage's,
    # so every blog/compare/guide post card was served as octet-stream and
    # silently refused to render on social platforms.
    location ~* /(opengraph-image|twitter-image)$ {
        default_type image/png;
        add_header Cache-Control "public, max-age=3600" always;
    }

    # Many crawlers, feed readers and legacy browsers still request /favicon.ico
    # by convention even though we advertise an SVG icon. Serve the SVG there
    # (correct content-type) instead of returning a 404.
    location = /favicon.ico {
        alias /var/www/agentty.org/favicon.svg;
        types { } default_type image/svg+xml;
        add_header Cache-Control "public, max-age=86400" always;
    }

    location /_next/static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # GitHub webhook endpoint for the auto-deploy service. Proxies to the local
    # listener (deploy/webhook.mjs, systemd: agentty-deploy-hook). The listener
    # verifies GitHub's HMAC-SHA256 signature, so this path is safe to expose;
    # only a correctly-signed push/release from the watched repos triggers a
    # deploy. Everything else is rejected (401) or ignored (202).
    location = /_deploy-hook {
        proxy_pass http://127.0.0.1:9099/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Hub-Signature-256 $http_x_hub_signature_256;
        proxy_set_header X-GitHub-Event $http_x_github_event;
        proxy_read_timeout 30s;
    }

    error_page 404 /404.html;
}

# ---------------------------------------------------------------------------
# stats.agentty.org — GoAccess real-time HTML dashboard.
# Static report + live WebSocket feed. Protected by HTTP basic auth.
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name stats.agentty.org;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name stats.agentty.org;

    ssl_certificate /etc/letsencrypt/live/agentty.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agentty.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/lib/goaccess/html;
    index index.html;

    # Lock the dashboard behind basic auth — generate the file with:
    #   sudo htpasswd -c /etc/nginx/agentty.htpasswd ayush
    auth_basic           "agentty.org analytics";
    auth_basic_user_file /etc/nginx/agentty.htpasswd;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # GoAccess real-time WebSocket feed (goaccess --real-time-html).
    # Browsers cannot send HTTP Basic-Auth on a WebSocket handshake, so this
    # location must be exempt from auth_basic or the upgrade 401s and the
    # dashboard hangs at "Authorizing WebSocket session...". The feed is
    # read-only stats and same-origin, so this is safe.
    location /ws {
        auth_basic off;
        proxy_pass http://127.0.0.1:7890;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 7d;
    }
}

# ---------------------------------------------------------------------------
# analytics.agentty.org — self-hosted Umami (client-side product analytics).
# Reverse-proxies the Umami container on 127.0.0.1:3001.
# ---------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name analytics.agentty.org;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name analytics.agentty.org;

    ssl_certificate /etc/letsencrypt/live/agentty.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agentty.org/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Umami serves its own dashboard UI + the /script.js tracker + /api ingest.
    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
