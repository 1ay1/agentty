server {
    listen 80;
    listen [::]:80;
    server_name dev.agentty.org;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name dev.agentty.org;

    # Reuse the *.agentty.org wildcard certificate.
    ssl_certificate     /etc/letsencrypt/live/agentty.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agentty.org/privkey.pem;

    ssl_session_timeout 1d;
    ssl_session_cache shared:AgenttyDevSSL:10m;
    ssl_session_tickets off;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;

    # dev.agentty.org is served from the SAME static export as the main site
    # (rsynced here by deploy.sh). The root of the origin IS the live,
    # interactive agentty terminal — the /dev/ page of the export.
    root /var/www/dev.agentty.org;
    index index.html;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Robots-Tag "noindex, nofollow" always;

    gzip on;
    gzip_vary on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json image/svg+xml font/woff2;
    gzip_static on;

    # Long cache for hashed static assets.
    location /_next/static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location ~* \.(css|js|svg|woff2?|gif|png|jpg|webp|ico)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
    }

    # ── LIVE agentty backend ──────────────────────────────────────────
    # Proxy the WebSocket (and health check) to the local live server, which
    # spawns the real agentty binary in a PTY against a mock model.
    location /live/ws {
        proxy_pass http://127.0.0.1:8790;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 660s;
        proxy_send_timeout 660s;
        proxy_buffering off;
    }
    location /live/health {
        proxy_pass http://127.0.0.1:8790;
        proxy_set_header Host $host;
    }

    # Root → the terminal (the exported /dev/ page).
    location = / {
        try_files /dev/index.html =404;
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ $uri.html $uri/index.html /dev/index.html;
        add_header Cache-Control "no-cache";
    }

    error_page 404 /404.html;
}
