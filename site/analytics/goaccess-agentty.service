[Unit]
Description=GoAccess real-time analytics dashboard for agentty.org
After=network.target nginx.service

[Service]
Type=simple
ExecStart=/home/ayush/projects/agentpp-site/analytics/goaccess-live.sh
Restart=always
RestartSec=3
# GoAccess must read root-owned logs and write the webroot report.
User=root

[Install]
WantedBy=multi-user.target
